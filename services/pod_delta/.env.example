# CyBreach Arena – Pod Delta environment
# Copy to .env and adjust for your machine.

# --- Application ---
PROJECT_NAME=CyBreach Arena
VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
# JWT_AUDIENCE=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL (or SQLite for local) ---
# Use sqlite for local-only; Postgres in compose:
# DATABASE_URL=postgresql+psycopg2://cybreach:cybreach@localhost:5432/cybreach
DATABASE_URL=sqlite:///./cybreach.db
POSTGRES_DSN=postgresql://cybreach:cybreach@localhost:5432/cybreach

# --- Redis (rate limits, score cache, ws sessions, pub/sub) ---
REDIS_URL=redis://localhost:6379/0
REDIS_WS_CHANNEL_PREFIX=ws:tenant

# --- Kafka / Redpanda ---
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CLIENT_ID=pod-delta-integration
KAFKA_CONSUMER_GROUP=pod-delta-integration
KAFKA_ENABLE=true
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_DLT_SUFFIX=.dlt

# --- ClickHouse (read-only for integration; Analytics Engine owns queries) ---
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=cybreach
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Rate limit / cache ---
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_EVENTS=20
SCORE_CACHE_TTL_SECONDS=3600
IDEMPOTENCY_TTL_SECONDS=86400

# --- WebSocket ---
WS_HEARTBEAT_SECONDS=30
WS_SESSION_TTL_SECONDS=90

# --- Analytics batch ---
ANALYTICS_FLUSH_INTERVAL_SECONDS=86400
ANALYTICS_RETENTION_DAYS=365
CACHE_TTL_SECONDS=300

PROMETHEUS_ENABLED=true
